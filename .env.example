# Producción: configurar en Vercel, sin subir valores reales al repositorio.
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:5432/postgres?sslmode=require
DJANGO_SECRET_KEY=REEMPLAZAR_POR_UN_VALOR_ALEATORIO_DE_AL_MENOS_50_CARACTERES
DJANGO_DEBUG=0
# Opcional: dominio adicional; Vercel aporta automáticamente sus dominios.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
